# Copie para .env e preencha. O arquivo .env nunca vai para o Git.
# Azure: nomes utilizados pelo módulo I2. SMTP permanece sob responsabilidade do I4.

# Azure Speech to Text (I2)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure AI Language (I2)
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=

# Para a interface analyze(): 1 autoriza chamadas Azure em cache miss.
# A CLI usa --allow-azure, independentemente desta variável. Padrão: sem chamadas.
TC_AUDIO_ALLOW_AZURE=0

# E-mail do alerta crítico (I4). Use conta dedicada com senha de app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# Destinatários (equipe médica da demo), separados por vírgula.
ALERT_EMAIL_TO=
